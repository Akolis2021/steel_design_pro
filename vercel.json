{
    "outputDirectory": "public",
    "builds": [
        {
            "src": "api/chat.js",
            "use": "@vercel/node"
        }
    ],
    "routes": [
        {
            "src": "/api/chat",
            "dest": "/api/chat.js"
        },
        {
            "src": "/(.*)",
            "dest": "/$1"
        }
    ]
}